{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-ci",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "cloud-ci",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "./Dockerfile",
      "max_instances": 10,
      "instance_type": "standard-4",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox",
      },
      {
        "name": "HEALER",
        "class_name": "Healer",
      },
      {
        "name": "REGISTRY",
        "class_name": "RunRegistry",
      },
    ],
  },
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "cloud-ci",
          "repo_name": "cloud-ci",
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "cloud-ci",
          },
        ],
      },
    ],
  },
  "workflows": [
    {
      "name": "cloud-ci",
      "binding": "CI_WORKFLOW",
      "class_name": "CI",
    },
  ],
  "exports": {
    "CiSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "Healer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "RunRegistry": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cloud-ci-backups","preview_bucket_name": "cloud-ci-backups",
    },
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "cloud-ci-backups",
    "WATCH_NAMESPACE": "cloud-ci",
    "WATCH_REPO": "cloud-ci",
    "CLOUDFLARE_ACCOUNT_ID": "384988241a425d49c5980f2b87b842c9",
    "CLOUDFLARE_DEPLOY_ACCOUNT_ID": "384988241a425d49c5980f2b87b842c9",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
}
